# Copy to .env and edit. Never commit real credentials.
POSTGRES_USER=trendscope
POSTGRES_PASSWORD=trendscope
POSTGRES_DB=trendscope

# Change this before any shared deployment. Rotating it invalidates existing tokens.
SECRET_KEY=dev-secret-change-me

ADMIN_EMAIL=admin@trendscope.app
ADMIN_PASSWORD=admin123

ENVIRONMENT=development

# Demo catalogue size. Lower these for a faster first boot.
MOCK_PRODUCT_LIMIT=48
MOCK_HISTORY_DAYS=400
