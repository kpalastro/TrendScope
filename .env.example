# Copy to .env and edit. Never commit real credentials.
POSTGRES_USER=trendscope
POSTGRES_PASSWORD=trendscope
POSTGRES_DB=trendscope

# Change this before any shared deployment. Rotating it invalidates existing tokens.
SECRET_KEY=dev-secret-change-me

ADMIN_EMAIL=admin@trendscope.app
ADMIN_PASSWORD=admin123

ENVIRONMENT=development

# Demo catalogue size. Lower these for a faster first boot.
MOCK_PRODUCT_LIMIT=48
MOCK_HISTORY_DAYS=400

# Optional authorised provider credentials. Every connector is disabled until
# its credentials are present and the source is enabled in the app. Never use a
# paid web subscription as an API or redistribution licence; review each
# provider's terms first.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# META_AD_LIBRARY_TOKEN=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Connector operations. Snapshots archive one normalised payload per sync and
# are pruned after the retention window; 0 disables pruning or truncation.
SNAPSHOT_MAX_RECORDS=5000
SNAPSHOT_RETENTION_DAYS=180
CONNECTOR_RETRY_ATTEMPTS=2
CONNECTOR_RETRY_BACKOFF_SECONDS=2.0
